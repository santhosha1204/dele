{
  "_version": "1.60.0",
  "sap.app": {
    "id": "products",
    "type": "application",
    "title": "Manage Products",
    "applicationVersion": { "version": "1.0.0" }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "products.view.Main",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.ui.layout": {} }
    },
    "models": {
      "i18n": { "type": "sap.ui.model.resource.ResourceModel", "settings": { "bundleName": "products.i18n.i18n" } }
    }
  }
}